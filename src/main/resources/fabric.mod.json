{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_url}",
    "issues": "${mod_tracker}",
    "sources": "https://github.com/The-Aether-Team/The-Aether-fabric"
  },
  "license": "${mod_license}",
  "icon": "aether.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.aetherteam.aether.fabric.AetherFabric"
    ],
    "client": [
      "com.aetherteam.aether.fabric.AetherFabricClient"
    ],
    "jei_mod_plugin": [
      "com.aetherteam.aether.integration.jei.AetherJEIPlugin"
    ]
  },
  "mixins": [
    "aether.mixins.json",
    "aether.twilightforest.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "jei": "*"
  }
}
